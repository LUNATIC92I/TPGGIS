# Configuration d'exemple du serveur TPGIS. AUCUN SECRET REEL ICI.
# En production, les valeurs sensibles proviennent du coffre de secrets de
# l'institution et sont injectees dans /etc/tpgis/tpgis.env (droits 600,
# proprietaire tpgis). Ne jamais versionner un fichier .env reel.

# Environnement : developpement | test | demonstration | production
TPGIS_ENVIRONNEMENT=production
TPGIS_NOM_INSTANCE=TPGIS-NATIONAL

# PostgreSQL : compte applicatif dedie, connexion locale ou reseau prive uniquement.
TPGIS_DATABASE_URL=postgresql+psycopg://tpgis_app:A_REMPLACER@127.0.0.1:5432/tpgis

# Cles de chiffrement (32 octets en base64). Generer avec : tpgis-admin generer-cles
# Format du trousseau : identifiant:cle[,identifiant:cle] ; la cle active chiffre les nouvelles donnees.
TPGIS_CLES_DONNEES=k1:A_REMPLACER_PAR_UNE_CLE_BASE64
TPGIS_CLE_DONNEES_ACTIVE=k1
TPGIS_CLE_INDEX=A_REMPLACER_PAR_UNE_CLE_BASE64
TPGIS_CLE_SAUVEGARDE=A_REMPLACER_PAR_UNE_CLE_BASE64

# Stockage (hors de tout repertoire publie par un serveur web)
TPGIS_REPERTOIRE_STOCKAGE=/var/lib/tpgis/stockage
TPGIS_REPERTOIRE_SAUVEGARDES=/var/backups/tpgis

# Ecoute : derriere le proxy TLS (nginx) sur la boucle locale
TPGIS_HOTE=127.0.0.1
TPGIS_PORT=8000
TPGIS_TLS_TERMINE_PAR_PROXY=true
# Ou TLS direct par uvicorn :
# TPGIS_TLS_CERTIFICAT=/etc/tpgis/tls/serveur.crt
# TPGIS_TLS_CLE=/etc/tpgis/tls/serveur.key

# Sessions et protection contre la force brute
TPGIS_SESSION_DUREE_MAX_MINUTES=480
TPGIS_SESSION_INACTIVITE_MINUTES=30
TPGIS_REAUTHENTIFICATION_VALIDITE_MINUTES=5
TPGIS_CONNEXION_MAX_ECHECS=5
TPGIS_CONNEXION_VERROU_MINUTES=15
TPGIS_LIMITE_CONNEXION_PAR_MINUTE_IP=10
TPGIS_LIMITE_REQUETES_PAR_MINUTE=300
TPGIS_MOT_DE_PASSE_LONGUEUR_MIN=12
TPGIS_MOT_DE_PASSE_VALIDITE_JOURS=180

# Antivirus ClamAV (obligatoire en production)
TPGIS_ANTIVIRUS=clamd
TPGIS_CLAMD_SOCKET=/run/clamav/clamd.ctl

# Biometrie : "aucun" tant qu'aucune integration institutionnelle n'est validee.
# "simulation" est interdit en production.
TPGIS_BIOMETRIE_ADAPTATEUR=aucun
TPGIS_BIOMETRIE_RECHERCHE_ACTIVE=false
