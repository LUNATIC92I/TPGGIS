# Sauvegarde chiffree quotidienne, suivie d'une verification d'integrite.
[Unit]
Description=TPGIS sauvegarde chiffree
After=postgresql.service

[Service]
Type=oneshot
User=tpgis
Group=tpgis
WorkingDirectory=/opt/tpgis
EnvironmentFile=/etc/tpgis/tpgis.env
ExecStart=/opt/tpgis/deployment/server/sauvegarde_quotidienne.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/tpgis /opt/tpgis/var
UMask=0077
